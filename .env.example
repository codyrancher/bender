# Bender environment configuration
#
# Copy this file to `.env` and fill in values. All configurable keys are now
# set here (the in-app template-keys UI has been removed). `.env` is injected
# into the container via docker-compose and forwarded to the API service.

# --- Host user (run: id -u && id -g) ---
# The uid/gid the container runs as. Files it writes to the bind-mounted ~/bender
# (pipelines, credentials, …) are owned by this user, so they stay editable on
# the host instead of being root-owned. (The Claude CLI also refuses to run as
# root.) Set these to your own id -u / id -g.
#
# Quick-fill your real ids:
#   printf 'PUID=%s\nPGID=%s\n' "$(id -u)" "$(id -g)" >> .env
PUID=1000
PGID=1000

# --- GitHub token (required) ---
# Classic PAT used to clone, push, and open + comment on PRs, and to run the
# definitions sync. Forwarded into containers as $GITHUB_TOKEN / $GH_TOKEN.
#
# Scope: public_repo  — push, PRs, and comments on PUBLIC repos (e.g.
#                       rancher/dashboard).
#
# Create one at https://github.com/settings/tokens (Tokens (classic)).
GITHUB_TOKEN=

# --- Git commit identity (required) ---
# Author name/email for commits made inside pipelines (the PAT above is auth
# only; this is who the commit is attributed to).
GIT_USER_NAME=
GIT_USER_EMAIL=

# --- Jira token (optional) ---
# API token for Jira, forwarded into pipeline containers as $JIRA_TOKEN for
# skills that talk to Jira. Like GITHUB_TOKEN, it's never written into workspace
# files — reference it at runtime ($JIRA_TOKEN). For Jira Cloud basic auth you
# also need an account email and your site URL; pass those as you see fit.
# Create one at https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_TOKEN=

# (The Rancher image tag is now chosen per-pipeline via the RANCHER_TAG
# argument in the New Pipeline dialog, not configured here.)

# --- External Rancher (optional) ---
# Point pipelines at an ALREADY-RUNNING Rancher instead of standing up a
# per-pipeline `rancher` sidecar. When RANCHER_URL is set, bender skips the
# sidecar (no k3s boot, no bootstrap) and skills target this instance directly
# via RANCHER_HOST_NAME. Useful on macOS/Colima, where the sidecar's nested k3s
# is unreliable. NOTE: reproductions will create/modify resources on this Rancher.
# RANCHER_URL=https://rancher.example.com
# RANCHER_ADMIN_USER=admin
# RANCHER_ADMIN_PASSWORD=

# --- Jira (SUSE) ---
# Personal access token for jira.suse.com, used by the rancher-jira-api helper
# (jira.sh) to read SURE bug reports + attachments in the extract/grooming stages.
# Create at: https://jira.suse.com/secure/ViewProfile.jspa → Personal Access Tokens.
# JIRA_TOKEN=

# --- Branch preview deploy (rancher-issue-fix pipeline) ---
# The Deploy Branch stage builds the fix branch and deploys a live preview via
# deploy-branch.sh, then Verify Fix tests that preview URL. It needs a kubeconfig
# for the preview cluster, injected base64-encoded (single-line, secret):
#   base64 -i /path/to/kubeconfig.yaml | tr -d '\n'
# PREVIEW_KUBECONFIG_B64=

# --- Cloud credentials ---
### THESE WILL NOT BE USEFUL UNTIL WE SETUP TUNNELING OR ACCESS TO THE RANCHER SERVER, I DID THIS PREVIOUSLY WITH PORT FORWARDING
## AWS (e.g. for EC2 provisioning / S3). Region defaults to us-west-2.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=us-west-2

## DigitalOcean personal access token (doctl / API).
# DIGITALOCEAN_ACCESS_TOKEN=
